import { Theme } from "theme.slint";
import { Button, CheckBox, ScrollView } from "std-widgets.slint";

export struct RuleRow {
    id: string,
    name: string,
    category: string,
    risk: string,
    enabled: bool,
    size_label: string,
    files_label: string,
}

export struct TweakRow {
    id: string,
    name: string,
    description: string,
    risk: string,
    selected: bool,
    applied: bool,
    requires_reboot: bool,
}

export struct StartupRow {
    id: string,
    name: string,
    command: string,
    location: string,
    enabled: bool,
}

component RiskBadge inherits Rectangle {
    in property <string> risk: "safe";
    // Fixed width so badges form one vertical column in lists
    width: 88px;
    height: 22px;
    border-radius: 4px;
    horizontal-stretch: 0;
    background: risk == "risky" ? Theme.risky :
                risk == "moderate" ? Theme.moderate : Theme.safe;
    Text {
        text: risk;
        color: #0b1015;
        font-size: 11px;
        font-weight: 700;
        horizontal-alignment: center;
        vertical-alignment: center;
        width: parent.width;
        height: parent.height;
    }
}

component SideNav inherits Rectangle {
    in property <string> label;
    in property <bool> active;
    callback clicked;
    height: 36px;
    border-radius: 8px;
    background: active ? #1c2733 : transparent;
    HorizontalLayout {
        padding-left: 12px;
        padding-right: 12px;
        Text {
            text: label;
            color: active ? Theme.accent : Theme.text;
            font-size: 14px;
            vertical-alignment: center;
        }
    }
    TouchArea {
        clicked => { root.clicked(); }
    }
}

component CleanupPage inherits VerticalLayout {
    in property <[RuleRow]> rules;
    in property <bool> busy;
    in property <float> progress;
    in property <string> results_text;
    callback analyze_clicked;
    callback clean_clicked;
    callback toggle_rule(int, bool);

    spacing: 12px;
    Text {
        text: @tr("Cleanup");
        color: Theme.text;
        font-size: 22px;
        font-weight: 700;
    }
    Text {
        text: @tr("Select categories, Analyze, then Clean. Reparse points and system roots are never deleted.");
        color: Theme.text-muted;
        wrap: word-wrap;
    }
    HorizontalLayout {
        spacing: 10px;
        Button {
            text: @tr("Analyze");
            enabled: !busy;
            clicked => { root.analyze_clicked(); }
        }
        Button {
            text: @tr("Clean");
            primary: true;
            enabled: !busy;
            clicked => { root.clean_clicked(); }
        }
        Text {
            text: results_text;
            color: Theme.accent;
            vertical-alignment: center;
        }
    }
    if busy: Rectangle {
        height: 6px;
        border-radius: 3px;
        background: Theme.border;
        Rectangle {
            width: parent.width * progress;
            height: parent.height;
            border-radius: 3px;
            background: Theme.accent;
        }
    }
    ScrollView {
        vertical-stretch: 1;
        VerticalLayout {
            spacing: 6px;
            for r[i] in rules: Rectangle {
                background: Theme.bg-elevated;
                border-radius: 8px;
                border-width: 1px;
                border-color: Theme.border;
                height: 52px;
                HorizontalLayout {
                    padding: 10px;
                    spacing: 12px;
                    alignment: center;
                    CheckBox {
                        checked: r.enabled;
                        horizontal-stretch: 0;
                        toggled => { root.toggle_rule(i, !r.enabled); }
                    }
                    // Fixed name column → badges share one X offset from the left
                    VerticalLayout {
                        width: 360px;
                        horizontal-stretch: 0;
                        spacing: 2px;
                        alignment: start;
                        Text {
                            text: r.name;
                            color: Theme.text;
                            font-size: 13px;
                            overflow: elide;
                            width: 100%;
                            horizontal-alignment: left;
                        }
                        Text {
                            text: r.category;
                            color: Theme.text-muted;
                            font-size: 11px;
                            width: 100%;
                            horizontal-alignment: left;
                        }
                    }
                    RiskBadge { risk: r.risk; }
                    Rectangle {
                        horizontal-stretch: 1;
                        background: transparent;
                    }
                    Text {
                        text: r.size_label;
                        color: Theme.text-muted;
                        vertical-alignment: center;
                        horizontal-alignment: right;
                        width: 90px;
                        horizontal-stretch: 0;
                    }
                    Text {
                        text: r.files_label;
                        color: Theme.text-muted;
                        vertical-alignment: center;
                        horizontal-alignment: right;
                        width: 70px;
                        horizontal-stretch: 0;
                    }
                }
            }
        }
    }
}

component OptimizePage inherits VerticalLayout {
    in property <[TweakRow]> tweaks;
    in property <bool> busy;
    callback apply_tweaks_clicked;
    callback revert_all_clicked;
    callback restore_point_clicked;
    callback toggle_tweak(int, bool);

    spacing: 12px;
    Text {
        text: @tr("Optimize");
        color: Theme.text;
        font-size: 22px;
        font-weight: 700;
    }
    Text {
        text: @tr("Advanced mode: Safe, Moderate, and Risky tweaks. A restore point is created before first apply.");
        color: Theme.text-muted;
        wrap: word-wrap;
    }
    HorizontalLayout {
        spacing: 10px;
        Button {
            text: @tr("Apply selected");
            primary: true;
            enabled: !busy;
            clicked => { root.apply_tweaks_clicked(); }
        }
        Button {
            text: @tr("Revert all");
            enabled: !busy;
            clicked => { root.revert_all_clicked(); }
        }
        Button {
            text: @tr("Create restore point");
            enabled: !busy;
            clicked => { root.restore_point_clicked(); }
        }
    }
    ScrollView {
        vertical-stretch: 1;
        VerticalLayout {
            spacing: 8px;
            for t[i] in tweaks: Rectangle {
                background: Theme.bg-elevated;
                border-radius: 8px;
                border-width: 1px;
                border-color: Theme.border;
                VerticalLayout {
                    padding: 12px;
                    spacing: 6px;
                    HorizontalLayout {
                        spacing: 10px;
                        alignment: center;
                        CheckBox {
                            checked: t.selected;
                            horizontal-stretch: 0;
                            toggled => { root.toggle_tweak(i, !t.selected); }
                        }
                        Text {
                            text: t.name;
                            color: Theme.text;
                            font-size: 14px;
                            font-weight: 600;
                            vertical-alignment: center;
                            width: 360px;
                            horizontal-stretch: 0;
                            overflow: elide;
                            horizontal-alignment: left;
                        }
                        RiskBadge { risk: t.risk; }
                        Rectangle {
                            horizontal-stretch: 1;
                            background: transparent;
                        }
                        if t.requires_reboot: Text {
                            text: @tr("reboot");
                            color: Theme.warning;
                            font-size: 11px;
                            vertical-alignment: center;
                            horizontal-stretch: 0;
                        }
                        if t.applied: Text {
                            text: @tr("applied");
                            color: Theme.accent;
                            font-size: 11px;
                            vertical-alignment: center;
                            horizontal-stretch: 0;
                        }
                    }
                    Text {
                        text: t.description;
                        color: Theme.text-muted;
                        font-size: 12px;
                        wrap: word-wrap;
                    }
                }
            }
        }
    }
}

component StartupPage inherits VerticalLayout {
    in property <[StartupRow]> startups;
    callback toggle_startup(int, bool);
    callback refresh_startup;

    spacing: 12px;
    HorizontalLayout {
        Text {
            text: @tr("Startup");
            color: Theme.text;
            font-size: 22px;
            font-weight: 700;
            horizontal-stretch: 1;
        }
        Button {
            text: @tr("Refresh");
            clicked => { root.refresh_startup(); }
        }
    }
    ScrollView {
        vertical-stretch: 1;
        VerticalLayout {
            spacing: 6px;
            for s[i] in startups: Rectangle {
                background: Theme.bg-elevated;
                border-radius: 8px;
                border-width: 1px;
                border-color: Theme.border;
                height: 56px;
                HorizontalLayout {
                    padding: 10px;
                    spacing: 12px;
                    CheckBox {
                        checked: s.enabled;
                        toggled => { root.toggle_startup(i, !s.enabled); }
                    }
                    VerticalLayout {
                        Text { text: s.name; color: Theme.text; font-size: 13px; }
                        Text {
                            text: s.command;
                            color: Theme.text-muted;
                            font-size: 11px;
                            overflow: elide;
                        }
                    }
                }
            }
        }
    }
}

component SettingsPage inherits VerticalLayout {
    in-out property <string> language;
    callback language_changed(string);
    spacing: 12px;
    Text {
        text: @tr("Settings");
        color: Theme.text;
        font-size: 22px;
        font-weight: 700;
    }
    Text {
        text: @tr("Language");
        color: Theme.text-muted;
    }
    HorizontalLayout {
        spacing: 8px;
        Button {
            text: "English";
            primary: language == "en";
            clicked => { language = "en"; root.language_changed("en"); }
        }
        Button {
            text: "Русский";
            primary: language == "ru";
            clicked => { language = "ru"; root.language_changed("ru"); }
        }
    }
    Text {
        text: @tr("Config and logs: %LOCALAPPDATA%\\Recleaner\\");
        color: Theme.text-muted;
        font-size: 12px;
    }
    Text {
        text: @tr("Open source MIT. Gaming tweaks marked Risky can reduce security — confirm before applying.");
        color: Theme.text-muted;
        wrap: word-wrap;
        font-size: 12px;
    }
}

export component AppWindow inherits Window {
    title: @tr("Recleaner");
    icon: @image-url("../resources/icon.png");
    preferred-width: 1100px;
    preferred-height: 720px;
    min-width: 900px;
    min-height: 600px;
    background: Theme.bg;

    in-out property <int> page: 0;
    in-out property <string> language: "en";
    in-out property <string> status_text: "";
    in-out property <float> progress: 0.0;
    in-out property <bool> busy: false;
    in-out property <string> results_text: "";
    in-out property <bool> show_confirm: false;
    in-out property <string> confirm_message: "";
    in-out property <string> confirm_action: "";

    in-out property <[RuleRow]> rules: [];
    in-out property <[TweakRow]> tweaks: [];
    in-out property <[StartupRow]> startups: [];

    callback analyze_clicked();
    callback clean_clicked();
    callback apply_tweaks_clicked();
    callback revert_all_clicked();
    callback restore_point_clicked();
    callback confirm_accepted();
    callback confirm_cancelled();
    callback language_changed(string);
    callback toggle_rule(int, bool);
    callback toggle_tweak(int, bool);
    callback toggle_startup(int, bool);
    callback refresh_startup();

    HorizontalLayout {
        spacing: 0;
        Rectangle {
            width: 200px;
            background: Theme.bg-sidebar;
            VerticalLayout {
                padding: 20px;
                spacing: 8px;
                Text {
                    text: "Recleaner";
                    color: Theme.accent;
                    font-size: 26px;
                    font-weight: 800;
                    font-family: "Segoe UI Semibold";
                }
                Text {
                    text: @tr("Clean · Optimize");
                    color: Theme.text-muted;
                    font-size: 12px;
                }
                Rectangle { height: 16px; background: transparent; }

                SideNav {
                    label: @tr("Cleanup");
                    active: page == 0;
                    clicked => { page = 0; }
                }
                SideNav {
                    label: @tr("Optimize");
                    active: page == 1;
                    clicked => { page = 1; }
                }
                SideNav {
                    label: @tr("Startup");
                    active: page == 2;
                    clicked => { page = 2; refresh_startup(); }
                }
                SideNav {
                    label: @tr("Settings");
                    active: page == 3;
                    clicked => { page = 3; }
                }
                Rectangle { vertical-stretch: 1; background: transparent; }
                Text {
                    text: status_text;
                    color: Theme.text-muted;
                    font-size: 11px;
                    wrap: word-wrap;
                }
            }
        }

        Rectangle {
            background: Theme.bg;
            VerticalLayout {
                padding: 24px;
                spacing: 16px;

                if page == 0: CleanupPage {
                    rules: rules;
                    busy: busy;
                    progress: progress;
                    results_text: results_text;
                    analyze_clicked => { root.analyze_clicked(); }
                    clean_clicked => { root.clean_clicked(); }
                    toggle_rule(i, v) => { root.toggle_rule(i, v); }
                }
                if page == 1: OptimizePage {
                    tweaks: tweaks;
                    busy: busy;
                    apply_tweaks_clicked => { root.apply_tweaks_clicked(); }
                    revert_all_clicked => { root.revert_all_clicked(); }
                    restore_point_clicked => { root.restore_point_clicked(); }
                    toggle_tweak(i, v) => { root.toggle_tweak(i, v); }
                }
                if page == 2: StartupPage {
                    startups: startups;
                    toggle_startup(i, v) => { root.toggle_startup(i, v); }
                    refresh_startup => { root.refresh_startup(); }
                }
                if page == 3: SettingsPage {
                    language: root.language;
                    language_changed(l) => { root.language = l; root.language_changed(l); }
                }
            }
        }
    }

    if show_confirm: Rectangle {
        x: 0; y: 0;
        width: parent.width;
        height: parent.height;
        background: #000000aa;
        Rectangle {
            width: 420px;
            height: 200px;
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            background: Theme.bg-elevated;
            border-radius: 10px;
            border-width: 1px;
            border-color: Theme.border;
            VerticalLayout {
                padding: 24px;
                spacing: 16px;
                Text {
                    text: @tr("Confirm");
                    color: Theme.text;
                    font-size: 18px;
                    font-weight: 700;
                }
                Text {
                    text: confirm_message;
                    color: Theme.text-muted;
                    wrap: word-wrap;
                    vertical-stretch: 1;
                }
                HorizontalLayout {
                    spacing: 12px;
                    alignment: end;
                    Button {
                        text: @tr("Cancel");
                        clicked => { root.confirm_cancelled(); }
                    }
                    Button {
                        text: @tr("Continue");
                        primary: true;
                        clicked => { root.confirm_accepted(); }
                    }
                }
            }
        }
    }
}
