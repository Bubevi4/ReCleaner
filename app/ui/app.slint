import { Theme } from "theme.slint";
import { CheckBox, ScrollView, Palette } from "std-widgets.slint";

export struct RuleRow {
    id: string,
    name: string,
    category: string,
    risk: string,
    enabled: bool,
    size_label: string,
    files_label: string,
}

export struct TweakRow {
    id: string,
    name: string,
    description: string,
    risk: string,
    selected: bool,
    applied: bool,
    requires_reboot: bool,
}

export struct StartupRow {
    id: string,
    name: string,
    command: string,
    location: string,
    enabled: bool,
}

component RiskBadge inherits Rectangle {
    in property <string> risk: "safe";
    // Fixed width so badges form one vertical column in lists
    width: 88px;
    height: 22px;
    border-radius: 4px;
    horizontal-stretch: 0;
    background: risk == "risky" ? Theme.risky :
                risk == "moderate" ? Theme.moderate : Theme.safe;
    Text {
        text: risk;
        color: Theme.text-on-accent;
        font-size: 11px;
        font-weight: 700;
        horizontal-alignment: center;
        vertical-alignment: center;
        width: parent.width;
        height: parent.height;
    }
}

// Custom buttons so primary uses Theme.accent (green), not Fluent blue.
component AppButton inherits Rectangle {
    in property <string> text;
    in property <bool> primary: false;
    in property <bool> enabled: true;
    callback clicked;

    height: 36px;
    min-width: 96px;
    border-radius: 6px;
    horizontal-stretch: 0;
    opacity: enabled ? 1.0 : 0.45;
    border-width: primary ? 0px : 1px;
    border-color: Theme.border;
    background: !enabled ? Theme.bg-elevated :
                primary ? (ta.has-hover ? Theme.accent-dim : Theme.accent) :
                (ta.has-hover ? Theme.bg-hover : Theme.bg-elevated);

    HorizontalLayout {
        padding-left: 16px;
        padding-right: 16px;
        Text {
            text: root.text;
            color: primary ? Theme.text-on-accent : Theme.text;
            font-size: 13px;
            font-weight: 600;
            vertical-alignment: center;
            horizontal-alignment: center;
        }
    }

    ta := TouchArea {
        enabled: root.enabled;
        mouse-cursor: root.enabled ? pointer : not-allowed;
        clicked => { root.clicked(); }
    }
}

component LangChip inherits Rectangle {
    in property <string> label;
    in property <bool> selected: false;
    callback clicked;

    height: 36px;
    min-width: 108px;
    border-radius: 6px;
    horizontal-stretch: 0;
    border-width: 1px;
    border-color: selected ? Theme.accent : Theme.border;
    background: selected ? Theme.accent : (ta.has-hover ? Theme.bg-hover : Theme.bg-elevated);

    HorizontalLayout {
        padding-left: 18px;
        padding-right: 18px;
        Text {
            text: root.label;
            color: selected ? Theme.text-on-accent : Theme.text;
            font-size: 13px;
            font-weight: 600;
            vertical-alignment: center;
            horizontal-alignment: center;
        }
    }

    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

component SideNav inherits Rectangle {
    in property <string> label;
    in property <bool> active;
    callback clicked;
    height: 36px;
    border-radius: 8px;
    background: active ? Theme.bg-hover : transparent;
    HorizontalLayout {
        padding-left: 12px;
        padding-right: 12px;
        Text {
            text: label;
            color: active ? Theme.accent : Theme.text;
            font-size: 14px;
            vertical-alignment: center;
        }
    }
    TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

component HintBanner inherits Rectangle {
    in property <string> text;
    in property <bool> is-error: false;
    border-radius: 8px;
    border-width: 1px;
    border-color: is-error ? Theme.danger : Theme.border;
    background: is-error ? Theme.danger-bg : Theme.bg-elevated;
    HorizontalLayout {
        padding: 14px;
        Text {
            text: root.text;
            color: is-error ? Theme.danger : Theme.text-muted;
            font-size: 13px;
            wrap: word-wrap;
            horizontal-stretch: 1;
        }
    }
}

component ProgressBar inherits Rectangle {
    in property <float> progress;
    height: 6px;
    border-radius: 3px;
    background: Theme.border;
    Rectangle {
        width: parent.width * progress;
        height: parent.height;
        border-radius: 3px;
        background: Theme.accent;
    }
}

component CleanupPage inherits VerticalLayout {
    in property <[RuleRow]> rules;
    in property <bool> busy;
    in property <float> progress;
    in property <string> results_text;
    in property <string> error_text;
    callback analyze_clicked;
    callback clean_clicked;
    callback toggle_rule(int, bool);

    spacing: 12px;
    Text {
        text: @tr("Cleanup");
        color: Theme.text;
        font-size: 22px;
        font-weight: 700;
    }
    Text {
        text: @tr("Select categories, Analyze, then Clean. Reparse points and system roots are never deleted.");
        color: Theme.text-muted;
        wrap: word-wrap;
    }
    HorizontalLayout {
        spacing: 10px;
        AppButton {
            text: @tr("Analyze");
            enabled: !busy;
            clicked => { root.analyze_clicked(); }
        }
        AppButton {
            text: @tr("Clean");
            primary: true;
            enabled: !busy;
            clicked => { root.clean_clicked(); }
        }
        Text {
            text: results_text;
            color: Theme.accent;
            vertical-alignment: center;
        }
    }
    if busy: ProgressBar { progress: progress; }
    if error_text != "": HintBanner {
        text: error_text;
        is-error: true;
    }
    if rules.length == 0 && !busy: HintBanner {
        text: @tr("No cleanup rules loaded.");
    }
    if rules.length > 0: ScrollView {
        vertical-stretch: 1;
        VerticalLayout {
            spacing: 6px;
            for r[i] in rules: Rectangle {
                background: Theme.bg-elevated;
                border-radius: 8px;
                border-width: 1px;
                border-color: Theme.border;
                height: 52px;
                HorizontalLayout {
                    padding: 10px;
                    spacing: 12px;
                    alignment: center;
                    CheckBox {
                        checked: r.enabled;
                        horizontal-stretch: 0;
                        toggled => { root.toggle_rule(i, !r.enabled); }
                    }
                    // Fixed name column → badges share one X offset from the left
                    VerticalLayout {
                        width: 360px;
                        horizontal-stretch: 0;
                        spacing: 2px;
                        alignment: start;
                        Text {
                            text: r.name;
                            color: Theme.text;
                            font-size: 13px;
                            overflow: elide;
                            width: 100%;
                            horizontal-alignment: left;
                        }
                        Text {
                            text: r.category;
                            color: Theme.text-muted;
                            font-size: 11px;
                            width: 100%;
                            horizontal-alignment: left;
                        }
                    }
                    RiskBadge { risk: r.risk; }
                    Rectangle {
                        horizontal-stretch: 1;
                        background: transparent;
                    }
                    Text {
                        text: r.size_label;
                        color: Theme.text-muted;
                        vertical-alignment: center;
                        horizontal-alignment: right;
                        width: 90px;
                        horizontal-stretch: 0;
                    }
                    Text {
                        text: r.files_label;
                        color: Theme.text-muted;
                        vertical-alignment: center;
                        horizontal-alignment: right;
                        width: 70px;
                        horizontal-stretch: 0;
                    }
                }
            }
        }
    }
    if rules.length == 0: Rectangle { vertical-stretch: 1; background: transparent; }
}

component OptimizePage inherits VerticalLayout {
    in property <[TweakRow]> tweaks;
    in property <bool> busy;
    in property <string> error_text;
    callback apply_tweaks_clicked;
    callback revert_all_clicked;
    callback restore_point_clicked;
    callback toggle_tweak(int, bool);

    spacing: 12px;
    Text {
        text: @tr("Optimize");
        color: Theme.text;
        font-size: 22px;
        font-weight: 700;
    }
    Text {
        text: @tr("Advanced mode: Safe, Moderate, and Risky tweaks. A restore point is created before first apply.");
        color: Theme.text-muted;
        wrap: word-wrap;
    }
    HorizontalLayout {
        spacing: 10px;
        AppButton {
            text: @tr("Apply selected");
            primary: true;
            enabled: !busy;
            clicked => { root.apply_tweaks_clicked(); }
        }
        AppButton {
            text: @tr("Revert all");
            enabled: !busy;
            clicked => { root.revert_all_clicked(); }
        }
        AppButton {
            text: @tr("Create restore point");
            enabled: !busy;
            clicked => { root.restore_point_clicked(); }
        }
    }
    if busy: ProgressBar { progress: 0.35; }
    if error_text != "": HintBanner {
        text: error_text;
        is-error: true;
    }
    if tweaks.length == 0 && !busy: HintBanner {
        text: @tr("No tweaks available.");
    }
    if tweaks.length > 0: ScrollView {
        vertical-stretch: 1;
        VerticalLayout {
            spacing: 8px;
            for t[i] in tweaks: Rectangle {
                background: Theme.bg-elevated;
                border-radius: 8px;
                border-width: 1px;
                border-color: Theme.border;
                VerticalLayout {
                    padding: 12px;
                    spacing: 6px;
                    // Same column idea as Cleanup: name left, badge column right-aligned.
                    HorizontalLayout {
                        spacing: 12px;
                        alignment: center;
                        CheckBox {
                            checked: t.selected;
                            horizontal-stretch: 0;
                            toggled => { root.toggle_tweak(i, !t.selected); }
                        }
                        Text {
                            text: t.name;
                            color: Theme.text;
                            font-size: 14px;
                            font-weight: 600;
                            vertical-alignment: center;
                            horizontal-stretch: 1;
                            overflow: elide;
                            horizontal-alignment: left;
                        }
                        if t.requires_reboot: Text {
                            text: @tr("reboot");
                            color: Theme.warning;
                            font-size: 11px;
                            vertical-alignment: center;
                            horizontal-stretch: 0;
                        }
                        if t.applied: Text {
                            text: @tr("applied");
                            color: Theme.accent;
                            font-size: 11px;
                            vertical-alignment: center;
                            horizontal-stretch: 0;
                        }
                        RiskBadge { risk: t.risk; }
                    }
                    Text {
                        text: t.description;
                        color: Theme.text-muted;
                        font-size: 12px;
                        wrap: word-wrap;
                    }
                }
            }
        }
    }
    if tweaks.length == 0: Rectangle { vertical-stretch: 1; background: transparent; }
}

component StartupPage inherits VerticalLayout {
    in property <[StartupRow]> startups;
    in property <string> error_text;
    callback toggle_startup(int, bool);
    callback refresh_startup;

    spacing: 12px;
    HorizontalLayout {
        Text {
            text: @tr("Startup");
            color: Theme.text;
            font-size: 22px;
            font-weight: 700;
            horizontal-stretch: 1;
        }
        AppButton {
            text: @tr("Refresh");
            clicked => { root.refresh_startup(); }
        }
    }
    if error_text != "": HintBanner {
        text: error_text;
        is-error: true;
    }
    if startups.length == 0: HintBanner {
        text: @tr("No startup items found.");
    }
    if startups.length > 0: ScrollView {
        vertical-stretch: 1;
        VerticalLayout {
            spacing: 6px;
            for s[i] in startups: Rectangle {
                background: Theme.bg-elevated;
                border-radius: 8px;
                border-width: 1px;
                border-color: Theme.border;
                height: 56px;
                HorizontalLayout {
                    padding: 10px;
                    spacing: 12px;
                    CheckBox {
                        checked: s.enabled;
                        toggled => { root.toggle_startup(i, !s.enabled); }
                    }
                    VerticalLayout {
                        Text { text: s.name; color: Theme.text; font-size: 13px; }
                        Text {
                            text: s.command;
                            color: Theme.text-muted;
                            font-size: 11px;
                            overflow: elide;
                        }
                    }
                }
            }
        }
    }
    if startups.length == 0: Rectangle { vertical-stretch: 1; background: transparent; }
}

component SettingsPage inherits VerticalLayout {
    in-out property <string> language;
    callback language_changed(string);

    spacing: 16px;
    alignment: start;

    Text {
        text: @tr("Settings");
        color: Theme.text;
        font-size: 22px;
        font-weight: 700;
    }

    // One compact group: language + path + safety note (mirrors Cleanup density)
    Rectangle {
        background: Theme.bg-elevated;
        border-radius: 8px;
        border-width: 1px;
        border-color: Theme.border;
        HorizontalLayout {
            // width follows content; avoid full-bleed stretch
            horizontal-stretch: 0;
            VerticalLayout {
                padding: 16px;
                spacing: 12px;
                alignment: start;

                Text {
                    text: @tr("Language");
                    color: Theme.text-muted;
                    font-size: 12px;
                    font-weight: 600;
                }
                HorizontalLayout {
                    spacing: 8px;
                    alignment: start;
                    LangChip {
                        label: "English";
                        selected: language == "en";
                        clicked => { language = "en"; root.language_changed("en"); }
                    }
                    LangChip {
                        label: "Русский";
                        selected: language == "ru";
                        clicked => { language = "ru"; root.language_changed("ru"); }
                    }
                }

                Rectangle {
                    height: 1px;
                    background: Theme.border;
                }

                Text {
                    text: @tr("Config and logs: %LOCALAPPDATA%\\Recleaner\\");
                    color: Theme.text-muted;
                    font-size: 12px;
                }
                Text {
                    text: @tr("Open source MIT. Gaming tweaks marked Risky can reduce security: confirm before applying.");
                    color: Theme.text-muted;
                    wrap: word-wrap;
                    font-size: 12px;
                    width: 420px;
                }
            }
        }
    }

    // Stretch sink so gaps do not open between Settings blocks
    Rectangle { vertical-stretch: 1; background: transparent; }
}

export component AppWindow inherits Window {
    title: @tr("Recleaner");
    icon: @image-url("../resources/icon.png");
    preferred-width: 1100px;
    preferred-height: 720px;
    min-width: 900px;
    min-height: 600px;
    background: Theme.bg;

    init => {
        Palette.color-scheme = ColorScheme.dark;
    }

    in-out property <int> page: 0;
    in-out property <string> language: "en";
    in-out property <string> status_text: "";
    in-out property <string> error_text: "";
    in-out property <float> progress: 0.0;
    in-out property <bool> busy: false;
    in-out property <string> results_text: "";
    in-out property <bool> show_confirm: false;
    in-out property <string> confirm_message: "";
    in-out property <string> confirm_action: "";
    in-out property <string> confirm_accept_label: @tr("Continue");
    in-out property <string> confirm_cancel_label: @tr("Cancel");

    in-out property <[RuleRow]> rules: [];
    in-out property <[TweakRow]> tweaks: [];
    in-out property <[StartupRow]> startups: [];

    callback analyze_clicked();
    callback clean_clicked();
    callback apply_tweaks_clicked();
    callback revert_all_clicked();
    callback restore_point_clicked();
    callback confirm_accepted();
    callback confirm_cancelled();
    callback language_changed(string);
    callback toggle_rule(int, bool);
    callback toggle_tweak(int, bool);
    callback toggle_startup(int, bool);
    callback refresh_startup();

    HorizontalLayout {
        spacing: 0;
        Rectangle {
            width: 200px;
            background: Theme.bg-sidebar;
            VerticalLayout {
                padding: 20px;
                spacing: 8px;
                Text {
                    text: "Recleaner";
                    color: Theme.accent;
                    font-size: 26px;
                    font-weight: 800;
                    font-family: "Segoe UI Semibold";
                }
                Text {
                    text: @tr("Clean · Optimize");
                    color: Theme.text-muted;
                    font-size: 12px;
                }
                Rectangle { height: 16px; background: transparent; }

                SideNav {
                    label: @tr("Cleanup");
                    active: page == 0;
                    clicked => { page = 0; }
                }
                SideNav {
                    label: @tr("Optimize");
                    active: page == 1;
                    clicked => { page = 1; }
                }
                SideNav {
                    label: @tr("Startup");
                    active: page == 2;
                    clicked => { page = 2; refresh_startup(); }
                }
                SideNav {
                    label: @tr("Settings");
                    active: page == 3;
                    clicked => { page = 3; }
                }
                Rectangle { vertical-stretch: 1; background: transparent; }
                Text {
                    text: status_text;
                    color: Theme.text-muted;
                    font-size: 11px;
                    wrap: word-wrap;
                }
            }
        }

        Rectangle {
            background: Theme.bg;
            VerticalLayout {
                padding: 24px;
                spacing: 16px;

                if page == 0: CleanupPage {
                    rules: rules;
                    busy: busy;
                    progress: progress;
                    results_text: results_text;
                    error_text: error_text;
                    analyze_clicked => { root.analyze_clicked(); }
                    clean_clicked => { root.clean_clicked(); }
                    toggle_rule(i, v) => { root.toggle_rule(i, v); }
                }
                if page == 1: OptimizePage {
                    tweaks: tweaks;
                    busy: busy;
                    error_text: error_text;
                    apply_tweaks_clicked => { root.apply_tweaks_clicked(); }
                    revert_all_clicked => { root.revert_all_clicked(); }
                    restore_point_clicked => { root.restore_point_clicked(); }
                    toggle_tweak(i, v) => { root.toggle_tweak(i, v); }
                }
                if page == 2: StartupPage {
                    startups: startups;
                    error_text: error_text;
                    toggle_startup(i, v) => { root.toggle_startup(i, v); }
                    refresh_startup => { root.refresh_startup(); }
                }
                if page == 3: SettingsPage {
                    language: root.language;
                    language_changed(l) => { root.language = l; root.language_changed(l); }
                }
            }
        }
    }

    if show_confirm: Rectangle {
        x: 0; y: 0;
        width: parent.width;
        height: parent.height;
        background: #000000aa;
        Rectangle {
            width: 420px;
            height: 200px;
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            background: Theme.bg-elevated;
            border-radius: 10px;
            border-width: 1px;
            border-color: Theme.border;
            VerticalLayout {
                padding: 24px;
                spacing: 16px;
                Text {
                    text: @tr("Confirm");
                    color: Theme.text;
                    font-size: 18px;
                    font-weight: 700;
                }
                Text {
                    text: confirm_message;
                    color: Theme.text-muted;
                    wrap: word-wrap;
                    vertical-stretch: 1;
                }
                HorizontalLayout {
                    spacing: 12px;
                    alignment: end;
                    AppButton {
                        text: confirm_cancel_label;
                        clicked => { root.confirm_cancelled(); }
                    }
                    AppButton {
                        text: confirm_accept_label;
                        primary: true;
                        clicked => { root.confirm_accepted(); }
                    }
                }
            }
        }
    }
}
