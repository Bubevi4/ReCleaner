msgid "Recleaner"
msgstr "Recleaner"

msgid "Clean · Optimize"
msgstr "Очистка · Оптимизация"

msgid "Cleanup"
msgstr "Очистка"

msgid "Optimize"
msgstr "Оптимизация"

msgid "Startup"
msgstr "Автозагрузка"

msgid "Settings"
msgstr "Настройки"

msgid "Select categories, Analyze, then Clean. Reparse points and system roots are never deleted."
msgstr "Выберите категории, Анализ, затем Очистка. Точки повторной обработки и системные корни не удаляются."

msgid "Analyze"
msgstr "Анализ"

msgid "Clean"
msgstr "Очистить"

msgid "Advanced mode: Safe, Moderate, and Risky tweaks. A restore point is created before first apply."
msgstr "Расширенный режим: безопасные, умеренные и рискованные твики. Перед первым применением создаётся точка восстановления."

msgid "Apply selected"
msgstr "Применить выбранные"

msgid "Revert all"
msgstr "Откатить всё"

msgid "Create restore point"
msgstr "Создать точку восстановления"

msgid "reboot"
msgstr "перезагрузка"

msgid "applied"
msgstr "применено"

msgid "Refresh"
msgstr "Обновить"

msgid "Language"
msgstr "Язык"

msgid "Config and logs: %LOCALAPPDATA%\\Recleaner\\"
msgstr "Конфиг и логи: %LOCALAPPDATA%\\Recleaner\\"

msgid "Open source MIT. Gaming tweaks marked Risky can reduce security: confirm before applying."
msgstr "Открытый MIT. Твики с меткой Risky снижают безопасность: подтвердите перед применением."

msgid "No cleanup rules loaded."
msgstr "Правила очистки не загружены."

msgid "No tweaks available."
msgstr "Твики недоступны."

msgid "No startup items found."
msgstr "Элементы автозагрузки не найдены."

msgid "Confirm"
msgstr "Подтверждение"

msgid "Cancel"
msgstr "Отмена"

msgid "Continue"
msgstr "Продолжить"
